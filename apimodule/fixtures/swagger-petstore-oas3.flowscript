/** GET /user/login — Logs user into the system. */
function loginUser(username: text? = null, password: text? = null, headers: Header* = []): text {
    return GetResponse(`/user/login{restQueryString([new RestParam { name: 'username', value: restText(username) }] & [new RestParam { name: 'password', value: restText(password) }])}`, headers);
}

/** GET /user/logout — Logs out current logged in user session. */
function logoutUser(headers: Header* = []): text {
    return GetResponse(`/user/logout`, headers);
}

/** GET /user/{username} — Get user by user name. */
function getUserByName(username: text, headers: Header* = []): User {
    let __raw = JSON.deserialize<{}>(GetResponse(`/user/{restPath(username)}`, headers));
    return unsafeCast<User>(__raw);
}

/** PUT /user/{username} — Update user resource. */
function updateUser(username: text, input: UserRequest, headers: Header* = []): text {
    return PutResponse(`/user/{restPath(username)}`, restJsonBody(input), headers);
}

/** DELETE /user/{username} — Delete user resource. */
function deleteUser(username: text, headers: Header* = []) {
    return DeleteResponse(`/user/{restPath(username)}`, headers);
}
